<Project>

  <!-- Settings shared across every project in the solution. Override per-csproj
       only when something genuinely needs to differ. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Authors>Trendvidia</Authors>
    <Description>C# port of the Protowire library for high-performance Protobuf text and binary serialization.</Description>
    <PackageProjectUrl>https://github.com/trendvidia/protowire-csharp</PackageProjectUrl>
    <Version>0.70.0</Version>
  </PropertyGroup>

</Project>
